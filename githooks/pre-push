#!/usr/bin/env bash
# Blocks a push whose tree does not pass the linters.
#
# Pre-push rather than pre-commit on purpose. A failing commit that never
# leaves the machine harms nobody, and a linter that fires on every
# commit is the fastest way to teach everyone to reach for --no-verify.
# A push is the first moment the work becomes someone else's problem and
# the step a pull request needs, so it is the last point where blocking
# is still cheap.
#
# Wired up by `core.hooksPath=githooks`, set by the `prepare` script in
# package.json — so it arrives with `bun install` rather than needing
# anyone to remember it.
set -uo pipefail

# git feeds the refs being pushed on stdin. A branch deletion has an
# all-zero local sha and no tree worth checking, so a push that only
# deletes goes straight through.
ZERO='0000000000000000000000000000000000000000'
root="$(git rev-parse --show-toplevel)"
status=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  # A branch deletion has an all-zero local sha and no tree to check.
  [ "$local_sha" = "$ZERO" ] && continue
  bash "$root/scripts/preflight.sh" "$local_sha" || status=1
done
exit "$status"
