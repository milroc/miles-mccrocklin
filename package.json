{
  "name": "miles-resume",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/splash/splash-entry.tsx",
    "./src/splash/effects.tsx",
    "*.css"
  ],
  "scripts": {
    "dev": "NODE_ENV=development bun --hot dev.ts",
    "build": "NODE_ENV=production bun build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "serve:dist": "bun run scripts/serve-dist.ts",
    "edit-ui": "bun scripts/edit-ui-copy.ts",
    "build:world-countries": "bun run scripts/build-world-countries.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-globe.gl": "^2.37.1",
    "react-icons": "^5.6.0",
    "three": "^0.184.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@playwright/test": "^1.62.1",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.184.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@types/topojson-simplify": "^3.0.3",
    "@types/topojson-specification": "^1.0.5",
    "bun-types": "latest",
    "exifr": "^7.1.3",
    "oxlint": "1.79.0",
    "playwright-core": "^1.62.1",
    "sharp": "^0.34.5",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^6.0.3"
  }
}
